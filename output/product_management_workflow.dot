// Product Management Process
digraph {
	rankdir=TB size="12,16"
	node [fontname=Arial fontsize=10]
	edge [fontname=Arial fontsize=9]
	1 [label="Request Made" fillcolor=lightgreen shape=ellipse style=filled]
	2 [label="Request to Product Manager?" fillcolor=lightyellow shape=diamond style=filled]
	3 [label="Create Epic on Prioritized Product Backlog" fillcolor=lightblue shape=box style=filled]
	4 [label="Redirect to Product Manager" fillcolor=lightblue shape=box style=filled]
	9 [label="Epic clear and viable?" fillcolor=lightyellow shape=diamond style=filled]
	10 [label="Refine the Epic" fillcolor=lightblue shape=box style=filled]
	5 [label="Product Managers Refine and Prioritize Epics" fillcolor=lightblue shape=box style=filled]
	6 [label="Engineering Creates Linked User Stories from Epics" fillcolor=lightblue shape=box style=filled]
	7 [label="User Stories Go into Upcoming Sprints" fillcolor=lightblue shape=box style=filled]
	8 [label="Sprint Ready" fillcolor=lightcoral shape=ellipse style=filled]
	1 -> 2
	2 -> 3 [label=Yes]
	2 -> 4 [label=No]
	3 -> 9
	4 -> 2
	9 -> 5 [label=Yes]
	9 -> 10 [label=No]
	10 -> 9
	5 -> 6
	6 -> 7
	7 -> 8
}
