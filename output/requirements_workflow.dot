// Requirements: Wall-Crawling Concrete Smoothing Robot
digraph {
	rankdir=TB size="12,16"
	node [fontname=Arial shape=box style="rounded,filled"]
	edge [fontname=Arial]
	title [label="Requirements
Wall-Crawling Concrete Smoothing Robot" fontsize=16 fontweight=bold shape=plaintext]
	start [label=START fillcolor=lightgreen shape=ellipse]
	title -> start [style=invis]
	step_1 [label="Epic clear and viable?" fillcolor=lightblue shape=diamond]
	start -> step_1
	failure_1 [label="Refine the epic" fillcolor=lightcoral shape=box]
	step_1 -> failure_1 [label=Failure color=red]
	failure_1 -> step_1 [label=Retry color=orange style=dashed]
	step_2 [label="Grip Dry Concrete

Activate claw grip on stable surface" fillcolor=lightyellow shape=box]
	step_1 -> step_2 [label=Success]
	failure_2 [label="Adjust grip strength" fillcolor=lightcoral shape=box]
	step_2 -> failure_2 [label=Failure color=red]
	failure_2 -> step_2 [label=Retry color=orange style=dashed]
	step_3 [label="Position Near Wet Concrete

Move front legs to smoothing position" fillcolor=lightyellow shape=box]
	step_2 -> step_3 [label=Success]
	failure_3 [label="Recalculate movement path" fillcolor=lightcoral shape=box]
	step_3 -> failure_3 [label=Failure color=red]
	failure_3 -> step_3 [label=Retry color=orange style=dashed]
	step_4 [label="Smooth Concrete

Apply pressure and smoothing technique" fillcolor=lightyellow shape=box]
	step_3 -> step_4 [label=Success]
	failure_4 [label="Adjust smoothing force" fillcolor=lightcoral shape=box]
	step_4 -> failure_4 [label=Failure color=red]
	failure_4 -> step_4 [label=Retry color=orange style=dashed]
	step_5 [label="Advance Forward

Move entire robot incrementally forward" fillcolor=lightyellow shape=box]
	step_4 -> step_5 [label=Success]
	step_5 -> step_2 [label="Success
(Loop back)" color=green style=dashed]
	failure_5 [label="Pause and debug mobility issue" fillcolor=lightcoral shape=box]
	step_5 -> failure_5 [label=Failure color=red]
	failure_5 -> step_5 [label=Retry color=orange style=dashed]
	end [label=END fillcolor=lightcoral shape=ellipse]
}
