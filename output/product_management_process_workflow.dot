// Product Management Process
digraph {
	rankdir=TB size="12,16"
	node [fontname=Arial shape=box style="rounded,filled"]
	edge [fontname=Arial]
	title [label="Product Management Process" fontsize=16 fontweight=bold shape=plaintext]
	1 [label="Request Made" fillcolor=lightgreen shape=ellipse]
	title -> 1 [style=invis]
	1 -> 2
	2 [label="Request to Product Manager?" fillcolor=lightblue shape=diamond]
	2 -> 3 [label=Yes color=green]
	2 -> 4 [label=No color=red]
	3 [label="Create Epic on Prioritized Product Backlog" fillcolor=lightyellow shape=box]
	3 -> 9
	4 [label="Redirect to Product Manager" fillcolor=lightyellow shape=box]
	4 -> 5
	9 [label="Epic clear and viable?" fillcolor=lightblue shape=diamond]
	9 -> 5 [label=Yes color=green]
	9 -> 10 [label=No color=red]
	10 [label="Refine the Epic" fillcolor=lightyellow shape=box]
	10 -> 9 [label="Loop back" color=orange style=dashed]
	5 [label="Product Managers Refine and Prioritize Epics" fillcolor=lightyellow shape=box]
	5 -> 6
	6 [label="Engineering Creates Linked User Stories from Epics" fillcolor=lightyellow shape=box]
	6 -> 7
	7 [label="User Stories Go into Upcoming Sprints" fillcolor=lightyellow shape=box]
	7 -> 8
	8 [label="Sprint Ready" fillcolor=lightcoral shape=ellipse]
}
